<?xml version="1.0" encoding="utf-8"?>
<!-- The whole artwork (icon-source/horse_horseshoe.webp, scaled to 64% on its own background colour) is the
     background layer, so every launcher mask shows the complete picture; the foreground stays empty. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
